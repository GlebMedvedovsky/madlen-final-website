---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getServices } from '../content/cms';
import { useTranslations } from '../i18n/utils';

const sourceServices = [
  {
    title: 'Portraitshooting',
    icon: '◎',
    description:
      'Ein Portraitshooting mit mir ist kein Fotoshooting im klassischen Sinne – es ist ein Gespräch mit Licht und Zeit. Ich arbeite mit natürlichem Licht, echten Orten und Ihrer Persönlichkeit. Das Ergebnis sind Bilder, die Sie so zeigen, wie Sie wirklich sind.',
  },
  {
    title: 'Paare & Familien',
    icon: '♡',
    description:
      'Ob frisch verliebt, seit Jahren zusammen oder mit Kindern unterwegs: gemeinsame Momente verdienen Bilder, die man nicht wegpackt. Ich begleite Sie an einem Ort, der Ihnen etwas bedeutet – ohne Regie, mit viel Raum für das Echte.',
  },
  {
    title: 'Hochzeiten',
    icon: '◇',
    description:
      'Hochzeitsfotografie ist Vertrauen. Ich bin an Ihrem großen Tag dabei – ruhig, aufmerksam und im Hintergrund – und halte die Momente fest, die keine Kamera bemerkt hat. Von der Vorbereitung bis zum Tanz.',
    highlighted: true,
  },
  {
    title: 'Events',
    icon: '✦',
    description:
      'Firmenfeiern, Kulturveranstaltungen, private Events – jedes Event hat seine eigene Energie. Ich dokumentiere Ihre Veranstaltung authentisch und in einer Qualität, die Sie stolz zeigen können.',
  },
  {
    title: 'Videografie',
    icon: '▷',
    description:
      'Bewegte Bilder erzählen Momente auf eine besondere Weise. Ich drehe mit ruhigem Blick und natürlicher Bildsprache – ob Hochzeitsfilm, Event-Video oder kreative Kurzproduktion. Ohne Überdramatik, dafür mit Seele.',
  },
  {
    title: 'Videoschnitt',
    icon: '⊞',
    description:
      'Sie haben bereits Rohmaterial und suchen jemanden, der daraus etwas Stimmiges macht? Ich übernehme auch reine Schnitt-Projekte – strukturiert, sorgfältig und mit dem Gespür für Rhythmus und Atmosphäre.',
  },
  {
    title: 'Editorial & Commercial',
    icon: '▣',
    description:
      'Fotografie für Magazine, Marken, Shops und kreative Projekte. Ob Produktfotografie, Brand-Shooting oder editoriale Bildwelten: Ich verstehe, was Ihr Projekt braucht, und liefere Bilder, die kommunizieren.',
    highlighted: true,
  },
];
const cmsServices = getServices('de');
const services = cmsServices.length ? cmsServices : sourceServices;
const t = useTranslations('de');
---

<Layout
  title="Leistungen – Foto & Video Madlen"
  description="Portraitshooting, Hochzeiten, Familienfotografie, Videografie und Editorial-Fotografie in Deutschland. Individuelle Angebote auf Anfrage."
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="section-label">{t.services.eyebrow}</span>
      <h1 class="page-hero-title">{t.services.titleLead}<br /><em>{t.services.titleEmphasis}</em></h1>
      <p class="page-hero-desc">
        {t.services.intro}
      </p>
    </div>
  </section>

  <!-- Services grid -->
  <section class="section services-section">
    <div class="container">
      <div class="services-grid">
        {services.map(s => (
          <ServiceCard
            title={s.title}
            description={s.description}
            icon={s.icon}
            highlighted={s.highlighted ?? false}
            headingLevel="h2"
            ctaHref="/kontakt"
            ctaLabel="Anfrage senden"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Process / How it works -->
  <section class="section section--cream process-section">
    <div class="container">
      <div class="process-inner">
        <span class="section-label">Wie es läuft</span>
        <h2 class="process-title">Vom ersten Wort<br /><em>bis zum fertigen Bild</em></h2>
        <span class="divider" aria-hidden="true"></span>

        <div class="process-steps">
          <div class="process-step">
            <span class="step-num" aria-hidden="true">01</span>
            <div>
              <h3 class="step-title">Anfrage</h3>
              <p>Sie schreiben mir – per E-Mail, WhatsApp oder über das Kontaktformular. Je mehr Sie mir über Ihr Projekt erzählen, desto besser.</p>
            </div>
          </div>
          <div class="process-step">
            <span class="step-num" aria-hidden="true">02</span>
            <div>
              <h3 class="step-title">Gespräch</h3>
              <p>Wir lernen uns kennen – kurz und persönlich. Ich verstehe Ihre Wünsche und beantworte alle Fragen.</p>
            </div>
          </div>
          <div class="process-step">
            <span class="step-num" aria-hidden="true">03</span>
            <div>
              <h3 class="step-title">Angebot</h3>
              <p>Sie erhalten ein maßgeschneidertes Angebot – transparent, ohne versteckte Kosten.</p>
            </div>
          </div>
          <div class="process-step">
            <span class="step-num" aria-hidden="true">04</span>
            <div>
              <h3 class="step-title">Shooting & Lieferung</h3>
              <p>Wir arbeiten zusammen, und ich liefere Ihnen die fertigen Bilder – sorgfältig bearbeitet und in Topqualität.</p>
            </div>
          </div>
        </div>

        <a href="/kontakt" class="btn btn-primary" style="margin-top: 3rem;">Jetzt anfragen</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-top: calc(var(--nav-height) + clamp(4rem, 5vw, 5rem));
    padding-bottom: 0;
    background-color: var(--color-cream);
  }

  .page-hero-title {
    color: var(--madlen-blue);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.25rem, 4.45vw, 4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .page-hero-title em,
  h2 em {
    color: inherit;
    font-style: normal;
    font-weight: inherit;
  }

  .page-hero-desc {
    color: var(--color-text);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 55ch;
  }

  /* Services grid */
  .services-section {
    padding-block: 2.75rem 0;
    background-color: var(--color-cream);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  /* Process */
  .process-section {
    padding-block: 4.5rem 3.5rem;
  }

  .process-inner {
    max-width: 800px;
  }

  .process-title {
    color: var(--madlen-blue);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 3.05vw, 2.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-top: var(--space-sm);
    margin-bottom: 0;
  }

  .process-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 768px) {
    .process-steps {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .process-step {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .step-num {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 300;
    color: var(--color-sand);
    line-height: 1;
    flex-shrink: 0;
    width: 2.5rem;
  }

  .step-title {
    color: var(--madlen-blue);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-xs);
  }

  .process-step p {
    color: var(--color-text);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 40ch;
  }

  @media (max-width: 600px) {
    .page-hero {
      padding-top: calc(var(--nav-height) + 2.25rem);
    }

    .page-hero-title {
      font-size: clamp(2.25rem, 10vw, 2.5rem);
    }

    .page-hero-desc {
      font-size: 1rem;
    }

    .services-section {
      padding-top: 1.75rem;
    }

    .services-grid {
      gap: 1.125rem;
    }

    .process-section {
      padding-block: 2.75rem 2.25rem;
    }

    .process-title {
      font-size: clamp(1.75rem, 8vw, 2rem);
    }

    .process-steps {
      gap: 2rem;
    }

    .step-title {
      font-size: 1.375rem;
    }

    .process-step p {
      font-size: 1rem;
    }
  }
</style>
