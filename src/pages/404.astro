---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Seite nicht gefunden – Foto & Video Madlen">
  <section class="not-found">
    <div class="container not-found-inner">
      <span class="not-found-num" aria-hidden="true">404</span>
      <h1 class="not-found-title">Diese Seite<br /><em>gibt es nicht.</em></h1>
      <span class="divider" aria-hidden="true"></span>
      <p>Das gesuchte Bild wurde nicht gefunden – aber vielleicht gibt es noch etwas Schöneres zu entdecken.</p>
      <div class="not-found-actions">
        <a href="/" class="btn btn-primary">Zur Startseite</a>
        <a href="/portfolio" class="btn btn-outline">Portfolio ansehen</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-height);
    background-color: var(--color-cream);
  }

  .not-found-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--space-3xl);
  }

  .not-found-num {
    font-family: var(--font-display);
    font-size: clamp(6rem, 20vw, 14rem);
    font-weight: 300;
    color: var(--color-sand);
    line-height: 1;
    display: block;
    margin-bottom: var(--space-lg);
  }

  .not-found-title {
    margin-bottom: 0;
  }

  .not-found-title em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-bronze);
  }

  .not-found-inner p {
    margin-top: var(--space-md);
    max-width: 45ch;
    text-align: center;
  }

  .not-found-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-xl);
  }
</style>
