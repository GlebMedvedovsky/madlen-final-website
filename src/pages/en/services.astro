---
import Layout from "../../layouts/Layout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { getServices } from "../../content/cms";
import { useTranslations } from "../../i18n/utils";

const services = getServices("en");
const t = useTranslations("en");
---

<Layout
  lang="en"
  title="Services – Foto & Video Madlen"
  description="Portrait, wedding and event photography, videography, editing and editorial photography by Madlen Medvedovskyy."
>
  <section class="page-hero services-page">
    <div class="container">
      <span class="section-label">{t.services.eyebrow}</span>

      <h1 class="page-hero-title">
        {t.services.titleLead}<br />
        <em>{t.services.titleEmphasis}</em>
      </h1>

      <p class="page-hero-desc">
        {t.services.intro}
      </p>
    </div>
  </section>

  <section class="services-section">
    <div class="container">
      <div class="services-grid">
        {services.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            highlighted={service.highlighted}
            headingLevel="h2"
          />
        ))}
      </div>

      <a href="/en/contact" class="page-button">
        Send inquiry ›
      </a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-top: calc(var(--nav-height) + clamp(4rem, 5vw, 5rem));
    padding-bottom: 0;
    background: var(--color-cream);
  }

  .page-hero-title {
    color: var(--madlen-blue);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.25rem, 4.45vw, 4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin: var(--space-sm) 0 var(--space-md);
  }

  .page-hero-title em {
    color: inherit;
    font-style: normal;
    font-weight: inherit;
  }

  .page-hero-desc {
    color: var(--color-text);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 58ch;
  }

  .services-section {
    padding-block: 2.75rem 3.5rem;
    background: var(--color-cream);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .page-button {
    display: inline-flex;
    margin-top: 2rem;
    padding: 0.8rem 1.4rem;
    border-radius: 999px;
    background: #0338da;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .page-hero {
      padding-top: calc(var(--nav-height) + 2.25rem);
    }

    .page-hero-title {
      font-size: clamp(2.25rem, 10vw, 2.5rem);
    }

    .page-hero-desc {
      font-size: 1rem;
    }

    .services-section {
      padding-block: 1.75rem 2.25rem;
    }

    .services-grid {
      gap: 1.125rem;
    }
  }
</style>
