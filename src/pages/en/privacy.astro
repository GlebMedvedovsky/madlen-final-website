---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  lang="en"
  title="Privacy Policy – Foto & Video Madlen"
  description="Privacy information for the Foto & Video Madlen website."
>
  <section class="legal-page">
    <div class="container">
      <span class="section-label">Legal</span>
      <h1>Privacy Policy</h1>
      <p>
        This page is an editable placeholder. The final privacy policy must be
        completed and legally reviewed before publication.
      </p>
      <h2>Contact form</h2>
      <p>
        Information submitted through the contact form is used solely to
        process and respond to the inquiry.
      </p>
      <h2>External services and cookies</h2>
      <p>
        Add the final details for hosting, analytics, embedded media and linked
        social platforms here.
      </p>
    </div>
  </section>
</Layout>

<style>
  .legal-page {
    min-height: 80vh;
    padding: calc(var(--nav-height) + 5rem) 0 6rem;
    background: #fff;
  }

  h1 {
    margin-bottom: 2rem;
    color: var(--madlen-blue);
    font-size: clamp(3.5rem, 8vw, 7rem);
  }

  h2 {
    margin: 2rem 0 0.6rem;
  }
</style>
