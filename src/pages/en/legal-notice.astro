---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  lang="en"
  title="Legal Notice – Foto & Video Madlen"
  description="Legal notice for Foto & Video Madlen."
>
  <section class="legal-page">
    <div class="container">
      <span class="section-label">Legal</span>
      <h1>Legal Notice</h1>
      <p>
        Editable placeholder: add the complete provider information required
        under German law before publishing the website.
      </p>
    </div>
  </section>
</Layout>

<style>
  .legal-page {
    min-height: 80vh;
    padding: calc(var(--nav-height) + 5rem) 0 6rem;
    background: #fff;
  }
  h1 {
    margin-bottom: 2rem;
    color: var(--madlen-blue);
    font-size: clamp(3.5rem, 8vw, 7rem);
  }
</style>
