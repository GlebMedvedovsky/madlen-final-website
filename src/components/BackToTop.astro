---
import { getLanguageFromUrl } from "../i18n/utils";

const label = getLanguageFromUrl(Astro.url) === "de" ? "Nach oben" : "Back to top";
---

<button
  class="back-to-top"
  id="back-to-top"
  type="button"
  aria-label={label}
  title={label}
  aria-hidden="true"
  tabindex="-1"
>
  <svg class="back-to-top__icon" viewBox="0 0 32 20" aria-hidden="true">
    <path d="M2 18 16 4l14 14" vector-effect="non-scaling-stroke" />
  </svg>
</button>

<script>
  const button = document.getElementById("back-to-top");

  const updateButton = () => {
    if (!button) return;
    const chatToggle = document.querySelector<HTMLButtonElement>("[data-chat-toggle]");
    const chatIsOpen = chatToggle?.getAttribute("aria-expanded") === "true";
    const shouldShow = window.scrollY > 500 && !chatIsOpen;

    button.classList.toggle("is-visible", shouldShow);
    button.setAttribute("aria-hidden", String(!shouldShow));
    button.tabIndex = shouldShow ? 0 : -1;
  };

  window.addEventListener("scroll", updateButton, { passive: true });
  window.addEventListener("madlen:chat-state-change", updateButton);

  button?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  });

  updateButton();
</script>

<style>
  .back-to-top {
    position: fixed;
    right: calc(
      var(--floating-control-edge, 24px) +
      var(--floating-control-size, 48px) +
      var(--floating-control-gap, 24px) +
      env(safe-area-inset-right, 0px)
    );
    bottom: calc(var(--floating-control-bottom, 24px) + env(safe-area-inset-bottom, 0px));
    z-index: 9998;

    width: var(--floating-control-size, 48px);
    height: var(--floating-control-size, 48px);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--madlen-blue);

    display: grid;
    place-items: center;
    cursor: pointer;

    opacity: 0;
    visibility: hidden;

    transition:
      opacity 180ms ease,
      visibility 180ms ease;
  }

  .back-to-top__icon {
    width: 32px;
    height: 20px;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .back-to-top:focus-visible {
    outline: 3px solid var(--madlen-pink);
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .back-to-top__icon {
      width: 28px;
      height: 18px;
    }
  }
</style>
