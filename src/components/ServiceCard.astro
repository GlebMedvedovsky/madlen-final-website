---
interface Props {
  title: string;
  description: string;
  icon?: string;
  highlighted?: boolean;
  headingLevel?: 'h2' | 'h3';
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  title,
  description,
  icon = '',
  highlighted = false,
  headingLevel = 'h3',
  ctaHref,
  ctaLabel,
} = Astro.props;
const TitleTag = headingLevel;
---

<div class:list={['service-card', { 'service-card--highlighted': highlighted }]}>
  {icon && (
    <div class="service-icon" aria-hidden="true">{icon}</div>
  )}
  <TitleTag class="service-title">{title}</TitleTag>
  <span class="divider" aria-hidden="true"></span>
  <p class="service-desc">{description}</p>
  {ctaHref && ctaLabel && (
    <a href={ctaHref} class="btn btn-outline service-btn">{ctaLabel}</a>
  )}
</div>

<style>
  .service-card {
    background-color: var(--color-white);
    border: 1px solid rgba(184, 83, 95, 0.2);
    padding: clamp(1.5rem, 2.4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    transition: border-color var(--transition);
  }

  .service-card:hover {
    border-color: rgba(184, 83, 95, 0.42);
  }

  .service-card--highlighted {
    background-color: var(--color-white);
    border-color: rgba(184, 83, 95, 0.2);
  }

  .service-icon {
    color: var(--madlen-blue);
    font-size: 1.35rem;
    line-height: 1;
    margin-bottom: var(--space-md);
  }

  .service-title {
    color: var(--madlen-blue);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.5rem, 2vw, 1.75rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin-bottom: 0;
  }

  .service-card .divider {
    margin-block: var(--space-md);
  }

  .service-desc {
    color: var(--color-text);
    font-size: 1.0625rem;
    line-height: 1.6;
    flex: 1;
    margin-bottom: var(--space-lg);
    max-width: 45ch;
  }

  .service-btn {
    font-size: 0.7rem;
    padding: 0.65rem 1.4rem;
    margin-top: auto;
  }

  @media (max-width: 600px) {
    .service-card {
      padding: 1.5rem;
    }

    .service-title {
      font-size: clamp(1.375rem, 6.2vw, 1.5rem);
    }

    .service-desc {
      font-size: 1rem;
      line-height: 1.6;
    }
  }
</style>
