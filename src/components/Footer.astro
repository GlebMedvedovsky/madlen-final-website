---
import {
  getLanguageFromUrl,
  useTranslations,
} from "../i18n/utils";

const lang = getLanguageFromUrl(Astro.url);
const t = useTranslations(lang);

const footerLinks = [
  {
    href: lang === "de" ? "/impressum" : "/en/legal-notice",
    label: t.footer.impressum,
  },
  {
    href: lang === "de" ? "/datenschutz" : "/en/privacy",
    label: t.footer.datenschutz,
  },
  {
    href: lang === "de" ? "/agb" : "/en/terms",
    label: t.footer.agb,
  },
  {
    href: lang === "de" ? "/kontakt" : "/en/contact",
    label: t.nav.contact,
  },
];

const copyright = t.footer.copyright;
---

<footer class="site-footer">
  <div class="footer-inner">
    <nav
      class="footer-navigation"
      aria-label={lang === "de"
        ? "Rechtliche Informationen"
        : "Legal information"}
    >
      <ul class="footer-links">
        {
          footerLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="footer-copy">
      {copyright}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 20;
    width: 100%;
    background: #f7e0e7;
    border-top: 1px solid rgba(201, 72, 93, 0.12);
    color: #c9485d;
    
  }

  .footer-inner {
    width: min(100%, 1560px);
    margin-inline: auto;
    padding: 0.8rem clamp(1.25rem, 4vw, 4.5rem) 0.7rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
  }

  .footer-navigation {
    width: 100%;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 5vw, 5.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-link {
    position: relative;
    display: inline-block;
    padding-block: 0.2rem;
    color: #c9485d;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .footer-link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .footer-link:hover {
    color: #0338da;
  }

  .footer-link:hover::after {
    transform: scaleX(1);
  }

  .footer-copy {
    max-width: none;
    margin: 0;
    color: #c9485d;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.035em;
    line-height: 1.3;
    text-align: center;
  }

  @media (max-width: 600px) {
    .footer-inner {
      padding-block: 1rem;
      gap: 0.75rem;
    }

    .footer-links {
      display: grid;
      grid-template-columns: repeat(2, auto);
      justify-content: center;
      column-gap: 2rem;
      row-gap: 0.7rem;
    }

    .footer-link {
      font-size: 0.68rem;
    }

    .footer-copy {
      font-size: 0.62rem;
    }
  }
</style>
