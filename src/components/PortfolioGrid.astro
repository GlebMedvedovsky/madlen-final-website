---
export interface PortfolioImage {
  src: string;
  alt: string;
  category: string;
  title?: string;
}

interface Props {
  images: PortfolioImage[];
  showFilter?: boolean;
}

const { images, showFilter = true } = Astro.props;

const categories = [
  'Alle',
  'Portraits',
  'Paare & Familien',
  'Hochzeiten',
  'Events',
  'Editorial & Commercial',
  'Video',
];
---

<section class="portfolio-section" aria-label="Portfolio Galerie">
  <div class="container">
    {showFilter && (
      <div class="portfolio-filters" aria-label="Portfolio Kategorien">
        {categories.map((category, index) => (
          <button
            type="button"
            class={index === 0 ? 'filter-btn filter-btn--active' : 'filter-btn'}
            data-filter={category}
          >
            {category}
          </button>
        ))}
      </div>
    )}

    <div class="portfolio-grid" id="portfolio-grid">
      {images.map((image, index) => (
        <button
          type="button"
          class="portfolio-item"
          data-category={image.category}
          data-index={index}
          data-src={image.src}
          data-alt={image.alt}
          aria-label={'Bild öffnen: ' + image.alt}
        >
          <img
            src={image.src}
            alt={image.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="portfolio-item-overlay" aria-hidden="true">
            <span>Ansehen</span>
          </span>
        </button>
      ))}
    </div>

    <div class="video-placeholder" id="video-placeholder" hidden>
      <span class="section-label">Videografie & Videoschnitt</span>
      <h2>Bewegte Bilder folgen.</h2>
      <p>
        Ausgewählte Videoprojekte werden hier ergänzt, sobald die passenden Arbeiten
        und Veröffentlichungsrechte bestätigt sind.
      </p>
      <a href="/kontakt#kontakt" class="btn btn-primary">Videoanfrage senden</a>
    </div>
  </div>

  <div class="lightbox" id="portfolio-lightbox" aria-hidden="true">
    <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Bild schließen">
      ×
    </button>

    <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Vorheriges Bild">
      ‹
    </button>

    <figure class="lightbox-figure">
      <img src="" alt="" class="lightbox-img" id="lightbox-img" />
      <figcaption class="lightbox-caption" id="lightbox-caption"></figcaption>
    </figure>

    <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Nächstes Bild">
      ›
    </button>
  </div>
</section>

<style>
  .portfolio-section {
    padding-block: var(--space-xl) var(--space-2xl);
    background-color: var(--color-white);
  }

  .portfolio-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-lg);
  }

  .filter-btn {
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-gray-dark);
    background-color: var(--color-white);
    border: 1px solid var(--color-sand);
    padding: 0.62rem 1rem;
    cursor: pointer;
    transition:
      background-color var(--transition),
      color var(--transition),
      border-color var(--transition),
      transform var(--transition);
  }

  .filter-btn:hover,
  .filter-btn--active {
    background-color: var(--color-gray-dark);
    border-color: var(--color-gray-dark);
    color: var(--color-white);
  }

  .filter-btn:hover {
    transform: translateY(-1px);
  }

  /*
    Strict editorial grid:
    Все карточки одинакового размера.
    Сетка выглядит ровно и профессионально.
    Полная фотография открывается в lightbox.
  */
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .portfolio-item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: none;
    background: var(--color-cream);
    cursor: zoom-in;
    overflow: hidden;
  }

  .portfolio-item[hidden] {
    display: none;
  }

  .portfolio-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition:
      transform 800ms ease,
      filter 800ms ease;
  }

  .portfolio-item:hover img {
    transform: scale(1.025);
    filter: brightness(0.84);
  }

  .portfolio-item-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    background: rgba(0, 0, 0, 0.18);
    opacity: 0;
    transition: opacity var(--transition);
    pointer-events: none;
  }

  .portfolio-item-overlay span {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid rgba(255, 255, 255, 0.72);
    padding: 0.7rem 1.1rem;
  }

  .portfolio-item:hover .portfolio-item-overlay {
    opacity: 1;
  }

  .video-placeholder {
    max-width: 680px;
    margin: var(--space-xl) auto 0;
    padding: var(--space-2xl);
    text-align: center;
    background-color: var(--color-cream);
    border: 1px solid var(--color-beige);
  }

  .video-placeholder h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .video-placeholder p {
    margin-inline: auto;
    max-width: 54ch;
  }

  .video-placeholder .btn {
    margin-top: var(--space-md);
    border-radius: 7px;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 3rem 5rem;
    background: rgba(10, 10, 10, 0.92);
  }

  .lightbox.is-open {
    display: flex;
  }

  .lightbox-figure {
    width: min(100%, 1400px);
    height: min(100%, 86vh);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 20px 80px rgba(0, 0, 0, 0.42);
  }

  .lightbox-caption {
    max-width: 900px;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.5;
    text-align: center;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    border: none;
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-white);
    cursor: pointer;
    transition:
      background-color var(--transition),
      transform var(--transition);
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .lightbox-close {
    top: 1.4rem;
    right: 1.4rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 2rem;
    line-height: 1;
  }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 72px;
    border-radius: 999px;
    font-size: 3rem;
    line-height: 1;
  }

  .lightbox-prev {
    left: 1.4rem;
  }

  .lightbox-next {
    right: 1.4rem;
  }

  .lightbox-nav:hover {
    transform: translateY(-50%) scale(1.04);
  }

  :global(body.lightbox-open) {
    overflow: hidden;
  }

  @media (max-width: 1100px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
  }

  @media (max-width: 900px) {
    .lightbox {
      padding: 2rem 1rem;
    }

    .lightbox-nav {
      width: 44px;
      height: 58px;
      font-size: 2.4rem;
    }

    .lightbox-prev {
      left: 0.6rem;
    }

    .lightbox-next {
      right: 0.6rem;
    }
  }

  @media (max-width: 560px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .portfolio-item {
      aspect-ratio: 4 / 5;
    }

    .portfolio-filters {
      gap: 0.45rem;
    }

    .filter-btn {
      font-size: 0.68rem;
      padding: 0.55rem 0.75rem;
    }

    .lightbox {
      padding: 4rem 0.75rem 2rem;
    }

    .lightbox-img {
      max-height: 76vh;
    }

    .lightbox-close {
      top: 0.8rem;
      right: 0.8rem;
    }

    .lightbox-nav {
      top: auto;
      bottom: 1rem;
      transform: none;
      width: 44px;
      height: 44px;
      font-size: 2rem;
    }

    .lightbox-nav:hover {
      transform: scale(1.04);
    }

    .lightbox-prev {
      left: calc(50% - 58px);
    }

    .lightbox-next {
      right: calc(50% - 58px);
    }

    .lightbox-caption {
      display: none;
    }
  }
</style>

<script>
  const filterButtons = Array.from(document.querySelectorAll('.filter-btn'));
  const portfolioItems = Array.from(document.querySelectorAll('.portfolio-item'));
  const videoPlaceholder = document.getElementById('video-placeholder');

  const lightbox = document.getElementById('portfolio-lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxCaption = document.getElementById('lightbox-caption');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  let activeCategory = 'Alle';
  let visibleItems = [];
  let currentIndex = 0;

  function updateVisibleItems() {
    visibleItems = portfolioItems.filter((item) => !item.hidden);
  }

  function applyFilter(category) {
    activeCategory = category;

    filterButtons.forEach((button) => {
      button.classList.toggle('filter-btn--active', button.dataset.filter === category);
    });

    const showVideo = category === 'Video';

    portfolioItems.forEach((item) => {
      const itemCategory = item.dataset.category;
      item.hidden = showVideo || !(category === 'Alle' || itemCategory === category);
    });

    if (videoPlaceholder) {
      videoPlaceholder.hidden = !showVideo;
    }

    updateVisibleItems();
  }

  function openLightbox(index) {
    updateVisibleItems();

    const item = visibleItems[index];
    if (!item || !lightbox || !lightboxImg || !lightboxCaption) return;

    currentIndex = index;

    const src = item.dataset.src || '';
    const alt = item.dataset.alt || '';

    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightboxCaption.textContent = alt;

    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.classList.add('lightbox-open');
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImg) return;

    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('lightbox-open');

    lightboxImg.src = '';
    lightboxImg.alt = '';
  }

  function showNextImage() {
    if (!visibleItems.length) return;
    currentIndex = (currentIndex + 1) % visibleItems.length;
    openLightbox(currentIndex);
  }

  function showPrevImage() {
    if (!visibleItems.length) return;
    currentIndex = (currentIndex - 1 + visibleItems.length) % visibleItems.length;
    openLightbox(currentIndex);
  }

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      applyFilter(button.dataset.filter || 'Alle');
    });
  });

  portfolioItems.forEach((item) => {
    item.addEventListener('click', () => {
      updateVisibleItems();
      const index = visibleItems.indexOf(item);
      if (index >= 0) {
        openLightbox(index);
      }
    });
  });

  if (closeBtn) {
    closeBtn.addEventListener('click', closeLightbox);
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', showNextImage);
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', showPrevImage);
  }

  if (lightbox) {
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });
  }

  document.addEventListener('keydown', (event) => {
    if (!lightbox || !lightbox.classList.contains('is-open')) return;

    if (event.key === 'Escape') {
      closeLightbox();
    }

    if (event.key === 'ArrowRight') {
      showNextImage();
    }

    if (event.key === 'ArrowLeft') {
      showPrevImage();
    }
  });

  applyFilter(activeCategory);
</script>