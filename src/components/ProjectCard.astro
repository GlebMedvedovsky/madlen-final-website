---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  lang: "de" | "en";
  index: number;
}

const { project, lang, index } = Astro.props;
const href =
  lang === "en"
    ? `/en/portfolio/${project.slug}`
    : `/portfolio/${project.slug}`;

const categoryLabels = {
  de: {
    editorial: "Editorial",
    events: "Events",
    weddings: "Hochzeiten",
    landscape: "Landschaft",
  },
  en: {
    editorial: "Editorial",
    events: "Events",
    weddings: "Weddings",
    landscape: "Landscape",
  },
};
---

<article class:list={["project-card", { "project-card--wide": index % 5 === 0 }]}>
  <a href={href} class="project-card__link">
    <div
      class="project-card__media"
      data-project-reveal
      style={`--reveal-delay: ${(index % 3) * 90}ms;`}
    >
      <img
        src={project.cover}
        alt={lang === "de"
          ? `${project.title.de} – Projekt von Madlen Medvedovskyy`
          : `${project.title.en} — project by Madlen Medvedovskyy`}
        loading={index < 3 ? "eager" : "lazy"}
      />
    </div>

    <div class="project-card__meta">
      <span>{categoryLabels[lang][project.category]}</span>
      <h2>{project.title[lang]}</h2>
      <span class="project-card__arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>

<style>
  .project-card {
    min-width: 0;
  }

  .project-card--wide {
    height: 100%;
  }

  .project-card__link {
    display: block;
  }

  .project-card__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--madlen-pink-soft);
  }

  :global(html.portfolio-reveal-ready) .project-card__media[data-project-reveal] {
    filter: opacity(0);
    transform: scale(0.5);
    transform-origin: center top;
    transition:
      filter 800ms ease,
      transform 800ms cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: filter, transform;
  }

  :global(html.portfolio-reveal-ready) .project-card__media[data-project-reveal].is-visible {
    filter: opacity(1);
    transform: scale(1);
  }

  .project-card--wide .project-card__media {
    aspect-ratio: 16 / 9;
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .project-card__link:hover .project-card__media img {
    transform: scale(1.025);
  }

  .project-card__meta {
    position: relative;
    padding: 0.85rem 2rem 1.4rem 0;
  }

  .project-card__meta > span:first-child {
    color: var(--madlen-blue);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-card h2 {
    margin-top: 0.15rem;
    color: var(--madlen-black);
    font-size: clamp(1.65rem, 2.6vw, 2.8rem);
    font-weight: 500;
  }

  .project-card__arrow {
    position: absolute;
    right: 0;
    bottom: 1.6rem;
    color: var(--madlen-blue);
    font-size: 1.2rem;
  }

  @media (max-width: 700px) {
    .project-card--wide {
      grid-column: auto;
    }

    .project-card--wide .project-card__media {
      aspect-ratio: 4 / 5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__media[data-project-reveal] {
      filter: none !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
