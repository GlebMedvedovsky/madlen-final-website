---
interface Props {
  pauseLabel: string;
  playLabel: string;
  fallback: string;
}

const { pauseLabel, playLabel, fallback } = Astro.props;
---

<section class="home-video" aria-label={playLabel}>
  <div class="home-video__frame">
    <video
      class="home-video__media"
      src="/images/hero/hero-video.mp4"
      poster="/images/hero/hero-video-poster.webp"
      width="848"
      height="480"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    >
      {fallback}
    </video>
    <button
      class="home-video__control"
      type="button"
      aria-label={pauseLabel}
      data-pause-label={pauseLabel}
      data-play-label={playLabel}
      aria-pressed="false"
    >
      <span class="home-video__pause" aria-hidden="true"></span>
      <span class="home-video__play" aria-hidden="true"></span>
      <span class="home-video__control-text">{pauseLabel}</span>
    </button>
  </div>
</section>

<script>
  const setupHomeVideo = () => {
    const frame = document.querySelector<HTMLElement>(".home-video__frame");
    if (!frame || frame.dataset.ready === "true") return;
    frame.dataset.ready = "true";

    const video = frame.querySelector<HTMLVideoElement>("video");
    const button = frame.querySelector<HTMLButtonElement>("button");
    if (!video || !button) return;

    let userPaused = false;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const render = () => {
      const paused = video.paused;
      const label = paused ? button.dataset.playLabel : button.dataset.pauseLabel;
      frame.classList.toggle("is-paused", paused);
      button.setAttribute("aria-label", label || "");
      button.setAttribute("aria-pressed", String(paused));
      const text = button.querySelector<HTMLElement>(".home-video__control-text");
      if (text) text.textContent = label || "";
    };

    const requestPlay = async () => {
      try {
        await video.play();
      } catch {
        userPaused = true;
      }
      render();
    };

    button.addEventListener("click", () => {
      if (video.paused) {
        userPaused = false;
        void requestPlay();
      } else {
        userPaused = true;
        video.pause();
        render();
      }
    });

    video.addEventListener("play", render);
    video.addEventListener("pause", render);

    if (reduceMotion.matches) {
      userPaused = true;
      video.pause();
      render();
    } else {
      void requestPlay();
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden && !video.paused) {
        video.pause();
      } else if (!document.hidden && !userPaused && !reduceMotion.matches) {
        void requestPlay();
      }
    });
  };

  setupHomeVideo();
  document.addEventListener("astro:page-load", setupHomeVideo);
</script>

<style>
  .home-video {
    width: 100%;
    background: var(--madlen-cream);
  }

  .home-video__frame {
    position: relative;
    width: min(100%, 1560px);
    aspect-ratio: 848 / 480;
    margin: 0 auto;
    overflow: hidden;
    background: #251710;
  }

  .home-video__media {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .home-video__control {
    position: absolute;
    right: clamp(0.75rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    min-width: 44px;
    min-height: 44px;
    padding: 0.65rem 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 999px;
    background: rgba(3, 56, 218, 0.9);
    color: #fff;
    font: 700 0.73rem/1 Arial, Helvetica, sans-serif;
    letter-spacing: 0.04em;
    cursor: pointer;
    backdrop-filter: blur(4px);
  }

  .home-video__control:focus-visible {
    outline: 3px solid var(--madlen-pink);
    outline-offset: 3px;
  }

  .home-video__pause {
    width: 10px;
    height: 13px;
    border-inline: 3px solid currentColor;
  }

  .home-video__play {
    display: none;
    width: 0;
    height: 0;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    border-left: 11px solid currentColor;
  }

  .is-paused .home-video__pause { display: none; }
  .is-paused .home-video__play { display: block; }

  @media (max-width: 1023px) {
    .home-video {
      padding-top: var(--nav-height);
    }
  }

  @media (max-width: 600px) {
    .home-video__control-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
