---
import { getLanguageFromUrl } from "../i18n/utils";
import { projects } from "../content/cms";
import { copy as chatCopy } from "../lib/madlen-assist";
const lang = getLanguageFromUrl(Astro.url);
const copy = chatCopy[lang];
const chatProjects = projects.map(({ slug, title, category }) => ({ slug, title, category }));
---

<div class="madlen-chat" data-chatbot data-language={lang} data-projects={JSON.stringify(chatProjects)}>
  <button
    class="chat-toggle"
    type="button"
    aria-label={copy.open}
    aria-expanded="false"
    aria-controls="madlen-chat-window"
    data-chat-toggle
  >
    <svg class="chat-toggle__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h9a4 4 0 0 1 4 4Z"></path>
    </svg>
  </button>

  <section id="madlen-chat-window" class="chat-window" aria-label={copy.title} hidden data-chat-window>
    <header class="chat-header">
      <div>
        <p>Foto & Video Madlen</p>
        <h2>{copy.title}</h2>
      </div>
      <button class="chat-close" type="button" aria-label={copy.close} data-chat-close>×</button>
    </header>

    <div class="chat-body" data-chat-body role="log" aria-label={copy.history} aria-live="polite" aria-relevant="additions" tabindex="0">
      <div class="chat-message chat-message--bot"><p>{copy.greeting}</p></div>
    </div>

    <div class="chat-quick-actions">
      {copy.quick.map((label) => (
        <button type="button" data-chat-question={label}>{label}</button>
      ))}
    </div>

    <form class="chat-form" data-chat-form>
      <label class="sr-only" for="chat-input">{copy.input}</label>
      <input id="chat-input" name="message" placeholder={copy.input} data-chat-input />
      <button type="submit">{copy.send}</button>
    </form>

    <p class="chat-note">{copy.note}</p>
  </section>
</div>

<script>
  import { answer, type Language, type ChatProject, type Reply } from "../lib/madlen-assist";
  const root = document.querySelector<HTMLElement>("[data-chatbot]");
  if (root) {
    const lang: Language = root.dataset.language === "en" ? "en" : "de";
    const projects: ChatProject[] = JSON.parse(root.dataset.projects || "[]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-chat-toggle]")!;
    const close = root.querySelector<HTMLButtonElement>("[data-chat-close]")!;
    const panel = root.querySelector<HTMLElement>("[data-chat-window]")!;
    const body = root.querySelector<HTMLElement>("[data-chat-body]")!;
    const form = root.querySelector<HTMLFormElement>("[data-chat-form]")!;
    const input = root.querySelector<HTMLInputElement>("[data-chat-input]")!;

    function setOpen(open: boolean) {
      const restoreFocus = !open && panel.contains(document.activeElement);
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      window.dispatchEvent(new CustomEvent("madlen:chat-state-change"));
      if (open) input.focus();
      else if (restoreFocus) toggle.focus();
    }
    function addMessage(text: string, kind: "user" | "bot", links: Reply["links"] = []) {
      const message = document.createElement("div");
      message.className = "chat-message chat-message--" + kind;
      const paragraph = document.createElement("p");
      paragraph.textContent = text;
      message.appendChild(paragraph);
      if (links.length) {
        const list = document.createElement("ul");
        for (const link of links) {
          const item = document.createElement("li");
          const anchor = document.createElement("a");
          anchor.textContent = link.label;
          anchor.href = link.href;
          item.appendChild(anchor);
          list.appendChild(item);
        }
        message.appendChild(list);
      }
      body.appendChild(message);
    }
    function submit(text: string) {
      const value = text.trim();
      if (!value) return;
      const result = answer(value, lang, projects);
      addMessage(value, "user");
      addMessage(result.text, "bot", result.links);
      body.scrollTop = body.scrollHeight;
    }
    toggle.addEventListener("click", () => setOpen(panel.hidden));
    close.addEventListener("click", () => setOpen(false));
    root.querySelectorAll<HTMLButtonElement>("[data-chat-question]").forEach(button => {
      button.addEventListener("click", () => submit(button.textContent || ""));
    });
    form.addEventListener("submit", event => {
      event.preventDefault();
      submit(input.value);
      input.value = "";
    });
    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && !panel.hidden) setOpen(false);
    });
  }
</script>

<style>
  .madlen-chat {
    position: fixed;
    right: calc(var(--floating-control-edge, 24px) + env(safe-area-inset-right, 0px));
    bottom: calc(var(--floating-control-bottom, 24px) + env(safe-area-inset-bottom, 0px));
    z-index: 9997;
    font-family: Arial, Helvetica, sans-serif;
  }

  .chat-form button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid var(--madlen-blue);
    border-radius: 999px;
    background: var(--madlen-blue);
    color: var(--madlen-pink);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .chat-toggle {
    display: grid;
    place-items: center;
    width: var(--floating-control-size, 48px);
    height: var(--floating-control-size, 48px);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--madlen-blue);
    color: var(--madlen-pink);
    cursor: pointer;
  }

  .madlen-chat:has(.chat-window:not([hidden])) {
    z-index: 9999;
  }

  .chat-toggle:hover {
    background: var(--madlen-pink);
    color: var(--madlen-blue);
  }

  .chat-toggle:focus-visible {
    outline: 3px solid var(--madlen-pink);
    outline-offset: 3px;
  }

  .chat-toggle__icon {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chat-form button:hover,
  .chat-form button:focus-visible {
    background: var(--madlen-pink);
    color: var(--madlen-blue);
    transform: translateY(-2px);
  }

  .chat-window {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 62px;
    width: min(390px, calc(100vw - 32px));
    height: min(600px, calc(100dvh - 110px - env(safe-area-inset-bottom, 0px)));
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto auto;
    overflow: hidden;
    border: 1px solid rgba(3, 56, 218, 0.16);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 24px 65px rgba(5, 5, 5, 0.2);
  }

  .chat-window[hidden] { display: none; }

  .chat-header {
    padding: 1.1rem 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background: var(--madlen-pink-soft);
  }

  .chat-header p {
    color: var(--madlen-blue);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .chat-header h2 {
    color: var(--madlen-blue);
    font-size: 1.45rem;
    font-weight: 600;
  }

  .chat-close {
    border: 0;
    background: transparent;
    color: var(--madlen-blue);
    font-size: 1.5rem;
    cursor: pointer;
  }

  .chat-body {
    min-height: 0;
    overscroll-behavior: contain;
    padding: 1rem;
    overflow: auto;
    background: var(--madlen-cream);
  }

  .madlen-chat :global(.chat-message) {
    width: fit-content;
    max-width: 92%;
    overflow-wrap: anywhere;
    margin-bottom: 0.7rem;
    padding: 0.75rem 0.9rem;
    border-radius: 14px;
  }

  .madlen-chat :global(.chat-message p) {
    color: inherit;
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .madlen-chat :global(.chat-message--bot) {
    background: #fff;
  }

  .madlen-chat :global(.chat-message--user) {
    margin-left: auto;
    background: var(--madlen-blue);
    color: var(--madlen-pink);
  }

  .madlen-chat :global(.chat-message ul) {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .madlen-chat :global(.chat-message li + li) { margin-top: 0.45rem; }
  .madlen-chat :global(.chat-message a) {
    color: var(--madlen-blue);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .madlen-chat :global(.chat-message a:focus-visible) {
    outline: 2px solid var(--madlen-blue);
    outline-offset: 3px;
  }

  .chat-quick-actions {
    padding: 0.85rem 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .chat-quick-actions button {
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--madlen-blue);
    border-radius: 999px;
    background: #fff;
    color: var(--madlen-blue);
    font-size: 0.7rem;
    cursor: pointer;
  }

  .chat-form {
    padding: 0 1rem 0.8rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
  }

  .chat-form input {
    min-width: 0;
    padding: 0.65rem 0.75rem;
    border: 1px solid rgba(5, 5, 5, 0.22);
    border-radius: 999px;
  }

  .chat-form button {
    padding: 0.65rem 0.8rem;
  }

  .chat-note {
    padding: 0 1rem 0.9rem;
    color: #777;
    font-size: 0.65rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .chat-window {
      position: fixed;
      right: calc(12px + env(safe-area-inset-right, 0px));
      bottom: calc(14px + env(safe-area-inset-bottom, 0px));
      width: min(390px, calc(100vw - 24px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)));
      max-height: calc(100dvh - 28px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));
      height: min(600px, calc(100dvh - 28px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px)));
    }
  }
</style>
