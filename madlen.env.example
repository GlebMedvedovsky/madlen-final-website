# Copy this file to .env only for local Compose overrides. Never commit secrets.
MADLEN_HTTP_PORT=8088
MADLEN_SITE_PORT=8089
MADLEN_DB_DATABASE=madlen
MADLEN_DB_USERNAME=madlen
MADLEN_DB_PASSWORD=replace-with-a-local-password
MADLEN_DB_ROOT_PASSWORD=replace-with-a-different-local-root-password
MADLEN_RESTORE_DB_PASSWORD=replace-with-a-test-only-password
MADLEN_RESTORE_DB_ROOT_PASSWORD=replace-with-a-different-test-root-password
